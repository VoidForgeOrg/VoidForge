            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "assembledAt": {
            "type": "string",
            "format": "date-time"
          },
          "ships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FleetShipResponse"
            }
          },
          "originPlanetId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "destinationPlanetId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
